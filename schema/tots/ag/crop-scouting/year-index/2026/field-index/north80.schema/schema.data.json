{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treeoftables.org/fixtures/ag/crop-scouting/year-index/2026/field-index/north80.schema/schema.data.json",
  "title": "crop_scouting_report data schema",
  "type": "object",
  "properties": {
    "report": {
      "type": "object",
      "properties": {
        "scout_date": {
          "type": "string",
          "format": "date"
        },
        "crop": {
          "type": "string"
        },
        "growth_stage": {
          "type": "string"
        },
        "scout_name": {
          "type": "string"
        },
        "weather": {
          "type": "string"
        }
      },
      "required": [
        "scout_date",
        "crop",
        "growth_stage",
        "scout_name",
        "weather"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "result",
          "severity",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string"
          },
          "observation_category": {
            "type": "string"
          },
          "attachment_path": {
            "type": "string",
            "contentMediaType": "image/png",
            "description": "Relative path to an image attachment; PNG is the recommended default"
          },
          "media_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "attachment_id",
          "observation_category",
          "attachment_path",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "priority",
          "recommendation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "report",
    "observations",
    "recommendations"
  ],
  "additionalProperties": false
}
